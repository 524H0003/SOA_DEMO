# Public DNS name pointing to this VPS. Put HTTPS in front of the container with Nginx.
APP_DOMAIN=absent.example.com

# FastAPI / Gmail configuration
FRONTEND_ORIGIN=https://absent.example.com
GMAIL_SENDER=absent-bot@your-domain.com
MANAGER_EMAIL=manager@your-domain.com
EMAIL_TEMPLATE_FILE=templates/absent_request.html
GOOGLE_CLOUD_PROJECT=your-gcp-project
PUBSUB_VERIFICATION_TOKEN=replace-with-a-long-random-token
PUBLIC_API_URL=https://absent.example.com
